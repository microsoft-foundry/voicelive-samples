{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "voiceLiveEndpoint": {
      "value": "${AZURE_VOICELIVE_ENDPOINT=}"
    },
    "voiceLiveApiKey": {
      "value": "${AZURE_VOICELIVE_API_KEY=}"
    },
    "voiceLiveMode": {
      "value": "${VOICELIVE_MODE=model}"
    },
    "voiceLiveAgentName": {
      "value": "${AZURE_VOICELIVE_AGENT_NAME=}"
    },
    "voiceLiveProject": {
      "value": "${AZURE_VOICELIVE_PROJECT=}"
    },
    "voiceLiveModel": {
      "value": "${VOICELIVE_MODEL=gpt-realtime}"
    },
    "voiceLiveVoice": {
      "value": "${VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural}"
    },
    "voiceLiveVoiceType": {
      "value": "${VOICELIVE_VOICE_TYPE=azure-standard}"
    },
    "voiceLiveTranscribeModel": {
      "value": "${VOICELIVE_TRANSCRIBE_MODEL=gpt-4o-transcribe}"
    },
    "createFoundry": {
      "value": "${CREATE_FOUNDRY=false}"
    },
    "createAgent": {
      "value": "${CREATE_AGENT=false}"
    },
    "foundryAccountName": {
      "value": "${FOUNDRY_ACCOUNT_NAME=}"
    },
    "foundryProjectName": {
      "value": "${FOUNDRY_PROJECT_NAME=voicelive-project}"
    },
    "agentModelDeploymentName": {
      "value": "${AGENT_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini}"
    },
    "agentName": {
      "value": "${AGENT_NAME=}"
    },
    "backendLanguage": {
      "value": "${BACKEND_LANGUAGE=python}"
    },
    "allowAnonymous": {
      "value": "${VOICELIVE_ALLOW_ANONYMOUS=false}"
    }
  }
}
