# Azure Voice Live API credentials
AZURE_VOICELIVE_ENDPOINT=https://your-resource-name.services.ai.azure.com/

# Authentication: DefaultAzureCredential is used by default (az login).
# Set API key below only as a fallback if token auth is unavailable.
AZURE_VOICELIVE_API_KEY=

# Connection mode: "model" or "agent" (default: model)
VOICELIVE_MODE=model

# Agent mode settings (using new SDK agent_name-based integration)
AZURE_VOICELIVE_AGENT_NAME=your-agent-name
AZURE_VOICELIVE_PROJECT=your-project-name
# Optional agent routing (server-controlled)
# AZURE_VOICELIVE_AGENT_VERSION=
# AZURE_VOICELIVE_FOUNDRY_RESOURCE_OVERRIDE=
# AZURE_VOICELIVE_AUTH_IDENTITY_CLIENT_ID=

# Allow browser clients to choose the agent, project, version, Foundry resource and
# identity used with this server's credential. Keep false for any deployed or shared app;
# set true only for trusted local development.
VOICELIVE_ALLOW_CLIENT_AGENT_OVERRIDE=false

# /ws requires a signed-in user (Azure Container Apps authentication) unless this is true.
# Local runs have no sign-in layer, so set true for local development only; never on a
# deployed or shared instance. (.env is not copied into container images.)
VOICELIVE_ALLOW_ANONYMOUS=false

# Model/BYOM mode settings
VOICELIVE_MODEL=gpt-realtime
VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
VOICELIVE_TRANSCRIBE_MODEL=gpt-4o-transcribe
VOICELIVE_INSTRUCTIONS=You are a helpful AI assistant. Respond naturally and conversationally. Keep your responses concise but engaging.

# Optional: BYOM profile (leave empty for standard model mode)
# VOICELIVE_BYOM_PROFILE=byom-azure-openai-realtime
